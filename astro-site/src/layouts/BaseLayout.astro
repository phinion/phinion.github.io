
---
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description?: string;
  currentPage?: string;
}

const {
  title,
  description = "Games, software and creative projects by Yash Vishwanath.",
  currentPage = "home"
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <meta name="description" content={description} />

    <title>{title} | Phinion</title>

    <link rel="stylesheet" href="/css/style.css" />
  </head>

  <body>
    <Navbar currentPage={currentPage} />

    <main>
        <slot />
    </main>

    <Footer />
  </body>
</html>
