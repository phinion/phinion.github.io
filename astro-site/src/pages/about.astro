---
import BaseLayout from "../layouts/BaseLayout.astro";

const experience = [
  {
    role: "Game Engineer",
    company: "Code Wizards",
    period: "July 2023 – Present",
    location: "Reading, UK",
    description:
      "Developing and supporting games across multiple platforms, from early prototyping through release and live support.",
    responsibilities: [
      "Designed and implemented gameplay systems and features using Unity and C#.",
      "Developed and optimised Unity applications for Nintendo Switch, PlayStation 5 and mobile.",
      "Worked across physics, UI, multiplayer, animation and audio systems.",
      "Built custom Unity Editor tools and contributed to performance optimisation.",
      "Supported CI/CD workflows using TeamCity for automated builds and deployments.",
      "Collaborated with clients on technical requirements and represented products at industry events."
    ],
    technologies: [
      "Unity",
      "Unreal",
      "C#",
      "C++",
      "Go",
      "Nintendo Switch",
      "PS5",
      "Mobile",
      "Azure",
      "Nakama",
      "PlayFab",
      "Pragma",
      "CI/CD"
    ]
  },
  {
    role: "Lead Programmer",
    company: "Fireslug Studios",
    period: "November 2020 – July 2023",
    location: "Remote",
    description:
      "Led a team of programmers developing a 3D action RPG in Unity.",
    responsibilities: [
      "Led and coordinated the programming team, delegating tasks and managing dependencies.",
      "Planned development milestones and translated requirements into actionable tasks.",
      "Designed and implemented gameplay systems and features using Unity and C#.",
      "Collaborated with other team leads on priorities and technical requirements.",
      "Conducted technical interviews and participated in recruitment."
    ],
    technologies: [
      "Unity",
      "C#",
      "Gameplay Systems",
      "Technical Leadership"
    ]
  }
];

const skillGroups = [
  {
    title: "Game Development",
    skills: [
      "Unity", "C#", "Gameplay Architecture",
      "Physics", "Multiplayer", "UI",
      "Animation", "Audio", "Optimisation"
    ]
  },
  {
    title: "Programming",
    skills: [
      "C++", "Python", "HTML",
      "CSS", "GLSL", "Unity Editor Tools"
    ]
  },
  {
    title: "Tools & DevOps",
    skills: [
      "Git", "Rider", "Visual Studio",
      "TeamCity", "CI/CD", "AWS",
      "Azure", "Docker"
    ]
  }
];

const interests = [
  "Music & Guitar",
  "Dance",
  "Yoga",
  "Climbing",
  "Technology",
  "Board Games",
  "Game Design"
];
---

<BaseLayout
  title="About"
  description="Learn about Yash Vishwanath, his game development career, technical skills and creative interests."
  currentPage="about"
>
  <div class="about-page container">

    <!-- Introduction -->
    <section class="about-intro">

      <div class="intro-text">
        <p class="eyebrow">A LITTLE ABOUT ME</p>

        <h1>Hey, I'm Yash!</h1>

        <p class="lead">
          I'm a Games Software Engineer with nearly
          six years of professional experience.
        </p>

        <p>
          I specialise in Unity, C# and cross-platform
          development, and I enjoy building gameplay
          systems, solving technical problems and
          exploring new technologies.
        </p>

        <p>
          Outside programming, I'm passionate about
          creative experiences, particularly music,
          dance and games.
        </p>
      </div>

      <div class="intro-image">
        <img
          src="/img/me.JPG"
          alt="Portrait of Yash"
          loading="lazy"
        />
      </div>

    </section>

    <!-- Career Timeline -->
    <section class="about-section" id="career">

      <div class="section-heading">
        <p class="eyebrow">MY JOURNEY</p>
        <h2>Career & Experience</h2>
        <p>
          The teams I've worked with and the
          projects I've helped bring to life.
        </p>
      </div>

      <div class="timeline">
        {experience.map((job, index) => (
          <div class="timeline-item">

            <div class="timeline-marker"></div>

            <details class="experience-card" open={index === 0}>

              <summary>
                <div class="experience-heading">
                  <span class="period">{job.period}</span>

                  <h3>{job.role}</h3>

                  <strong>{job.company}</strong>

                  <span class="location">{job.location}</span>

                  <p>{job.description}</p>
                </div>

                <span class="expand-icon" aria-hidden="true">
                  +
                </span>
              </summary>

              <div class="experience-details">
                <h4>Responsibilities & Contributions</h4>

                <ul>
                  {job.responsibilities.map((item) => (
                    <li>{item}</li>
                  ))}
                </ul>

                <div class="skill-tags">
                  {job.technologies.map((technology) => (
                    <span>{technology}</span>
                  ))}
                </div>
              </div>

            </details>
          </div>
        ))}
      </div>
    </section>

    <!-- Technical Skills -->
    <section class="about-section" id="skills">

      <div class="section-heading">
        <p class="eyebrow">WHAT I WORK WITH</p>
        <h2>Technical Skills</h2>
      </div>

      <div class="skills-grid">
        {skillGroups.map((group) => (
          <div class="skill-group">
            <h3>{group.title}</h3>

            <div class="skill-tags">
              {group.skills.map((skill) => (
                <span>{skill}</span>
              ))}
            </div>
          </div>
        ))}
      </div>

    </section>

    <!-- Education -->
    <section class="about-section" id="education">

      <div class="section-heading">
        <p class="eyebrow">EDUCATION & LEARNING</p>
        <h2>Education & Certifications</h2>
      </div>

      <div class="education-grid">

        <div class="education-card">
          <span class="period">2017 – 2020</span>
          <h3>Games Software Engineering</h3>
          <p>Bournemouth University</p>
        </div>

        <div class="education-card">
          <span class="period">September 2026</span>
          <h3>AWS Certified Developer – Associate</h3>
          <p>Amazon Web Services</p>
        </div>

      </div>

    </section>

    <!-- Personal Interests -->
    <section class="about-section" id="interests">

      <div class="section-heading">
        <p class="eyebrow">BEYOND THE CODE</p>
        <h2>More Than a Programmer</h2>
      </div>

      <p>
        I love exploring different creative outlets,
        learning new things and finding inspiration
        outside game development.
      </p>

      <div class="skill-tags">
        {interests.map((interest) => (
          <span>{interest}</span>
        ))}
      </div>

      <p class="interests-link">
        <a href="/projects/">
          Explore my creative projects →
        </a>
      </p>

    </section>

  </div>
</BaseLayout>

<style>
  .about-page {
    padding: 3rem 0 5rem;
  }

  .eyebrow {
    color: var(--color-accent);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  /* Introduction */

  .about-intro {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    align-items: center;
    gap: 4rem;
    margin-bottom: 5rem;
  }

  .intro-text h1 {
    font-size: clamp(2.5rem, 6vw, 4rem);
    margin: 1rem 0;
  }

  .intro-text p {
    color: var(--color-text-muted);
    line-height: 1.8;
  }

  .intro-text .lead {
    color: var(--color-text);
    font-size: 1.3rem;
  }

  .intro-image {
    width: 100%;
    max-width: 360px;
    justify-self: end;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    border-radius: 16px;
  }

  .intro-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Sections */

  .about-section {
    margin-bottom: 5rem;
  }

  .section-heading {
    margin-bottom: 2rem;
  }

  .section-heading h2 {
    font-size: clamp(2rem, 4vw, 2.8rem);
    margin: 0.5rem 0;
  }

  .section-heading > p:last-child {
    color: var(--color-text-muted);
  }

  /* Timeline */

  .timeline {
    border-left: 2px solid var(--color-border);
    margin-left: 10px;
    padding-left: 2rem;
  }

  .timeline-item {
    position: relative;
    margin-bottom: 1.5rem;
  }

  .timeline-marker {
    position: absolute;
    left: calc(-2rem - 17px);
    top: 1.75rem;
    width: 12px;
    height: 12px;
    background: var(--color-orange);
    border-radius: 50%;
  }

  .experience-card {
    background: var(--color-surface);
    border-radius: 12px;
    overflow: hidden;
  }

  .experience-card summary {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.5rem;
    cursor: pointer;
    list-style: none;
  }

  .experience-card summary::-webkit-details-marker {
    display: none;
  }

  .experience-heading h3 {
    margin: 0.5rem 0;
    font-size: 1.5rem;
  }

  .experience-heading strong {
    display: block;
  }

  .experience-heading p {
    color: var(--color-text-muted);
    margin-bottom: 0;
  }

  .period {
    color: var(--color-accent);
    font-size: 0.85rem;
    font-weight: 600;
  }

  .location {
    display: block;
    color: var(--color-text-muted);
    font-size: 0.85rem;
    margin-top: 0.25rem;
  }

  .expand-icon {
    color: var(--color-accent);
    font-size: 1.8rem;
    line-height: 1;
  }

  details[open] .expand-icon {
    transform: rotate(45deg);
  }

  .experience-details {
    padding: 0 1.5rem 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .experience-details h4 {
    margin-top: 1.5rem;
  }

  .experience-details li {
    color: var(--color-text-muted);
    line-height: 1.7;
    margin-bottom: 0.75rem;
  }

  /* Tags */

  .skill-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.5rem;
  }

  .skill-tags span {
    background: var(--color-surface-light);
    padding: 0.4rem 0.8rem;
    border-radius: 6px;
    font-size: 0.85rem;
  }

  /* Skills */

  .skills-grid,
  .education-grid {
    display: grid;
    grid-template-columns:
      repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 1.5rem;
  }

  .skill-group,
  .education-card {
    background: var(--color-surface);
    padding: 1.5rem;
    border-radius: 12px;
  }

  .skill-group h3 {
    margin-top: 0;
  }

  .education-card h3 {
    margin-bottom: 0.5rem;
  }

  .education-card p {
    color: var(--color-text-muted);
  }

  /* Interests */

  #interests > p {
    color: var(--color-text-muted);
    max-width: 750px;
  }

  .interests-link {
    margin-top: 2rem;
  }

  .interests-link a {
    color: var(--color-accent);
    text-decoration: none;
    font-weight: 600;
  }

  .interests-link a:hover {
    text-decoration: underline;
  }

  /* Mobile */

  @media (max-width: 700px) {
    .about-intro {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .intro-image {
      justify-self: center;
      max-width: 300px;
    }

    .timeline {
      padding-left: 1.25rem;
    }

    .timeline-marker {
      left: calc(-1.25rem - 17px);
    }
  }
</style>