---
import BaseLayout from "../../layouts/BaseLayout.astro";
import YouTubeEmbed from "../../components/YouTubeEmbed.astro";

import { getCollection, render } from "astro:content";
import type { CollectionEntry } from "astro:content";

interface Props {
  project: CollectionEntry<"projects">;
}

// Generate one page per project.
export async function getStaticPaths() {
  const projects = await getCollection("projects");

  return projects.map((project) => ({
    params: { id: project.id },
    props: { project }
  }));
}

const { project } = Astro.props;

const { Content } = await render(project);

const {
  title,
  description,
  category,
  type,
  image,
  youtubeUrl,
  link
} = project.data;

const relatedPosts = (
  await getCollection(
    "blog",
    ({ data }) => !data.draft
  )
)
  .filter(
    (post) => post.data.project?.id === project.id
  )
  .sort(
    (a, b) =>
      b.data.pubDate.getTime() -
      a.data.pubDate.getTime()
  );

function formatDate(date: Date): string {
  return date.toLocaleDateString("en-GB", {
    day: "numeric",
    month: "short",
    year: "numeric",
    timeZone: "UTC"
  });
}
---

<BaseLayout
  title={title}
  description={description}
  currentPage="projects"
>
  <article class="project-page container">

    <a class="back-link" href="/projects/">
      ← Back to Projects
    </a>

    <div class="project-header">

      <div class="categories">
        <span>{category}</span>
        <span>{type}</span>
      </div>

      <h1>{title}</h1>

      <p>{description}</p>

    </div>

    {(youtubeUrl || image) && (
      <section
        class="project-media"
        aria-label="Project media"
      >
        {youtubeUrl ? (
          <YouTubeEmbed
            url={youtubeUrl}
            title={`${title} Gameplay`}
          />
        ) : image ? (
          <img
            src={image}
            alt={title}
          />
        ) : null}
      </section>
    )}

    {link && (
      <div class="project-links">
        <a
          href={link}
          target="_blank"
          rel="noopener noreferrer"
        >
          Visit Project ↗
        </a>
      </div>
    )}

    <section class="project-content">
      <Content />
    </section>

    {youtubeUrl && (
      <div class="extra-links">
        <a
          href={youtubeUrl}
          target="_blank"
          rel="noopener noreferrer"
        >
          Watch on YouTube ↗
        </a>
      </div>
    )}

    {relatedPosts.length > 0 && (
      <section class="related-posts">

        <h2>Development Journal</h2>

        <p class="related-intro">
          Articles and updates about this project.
        </p>

        <div class="related-post-list">

          {relatedPosts.map((post) => (
            <a
              class="related-post"
              href={`/blog/${post.id}/`}
            >

              <div class="related-post-info">

                <span class="post-category">
                  {post.data.category}
                </span>

                <h3>{post.data.title}</h3>

                <p>{post.data.description}</p>

                {post.data.tags.length > 0 && (
                  <div class="post-tags">
                    {post.data.tags.map((tag) => (
                      <span>{tag}</span>
                    ))}
                  </div>
                )}

              </div>

              <time
                datetime={post.data.pubDate.toISOString()}
              >
                {formatDate(post.data.pubDate)}
              </time>

            </a>
          ))}

        </div>
      </section>
    )}

  </article>
</BaseLayout>

<style>
  .project-page {
    max-width: 960px;
    margin: 0 auto;
    padding: 3rem 1.5rem 5rem;
    color: var(--color-text, #f4f6f8);
  }

  .back-link {
    display: inline-block;
    margin-bottom: 2rem;
    color: var(--color-accent, #b8d47a);
    text-decoration: none;
  }

  .back-link:hover {
    text-decoration: underline;
  }

  .project-header {
    margin-bottom: 2rem;
  }

  .project-header h1 {
    color: var(--color-text, #f4f6f8);
    font-size: clamp(2.5rem, 6vw, 4rem);
    line-height: 1.1;
    margin: 1rem 0;
  }

  .project-header p {
    color: var(--color-text-muted, #b5c0cc);
    font-size: 1.1rem;
    line-height: 1.7;
    max-width: 700px;
  }

  .categories {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .categories span {
    background: var(--color-surface-light, #293442);
    color: var(--color-accent, #b8d47a);
    padding: 0.5rem 1rem;
    border-radius: 6px;
    text-transform: capitalize;
    font-size: 0.85rem;
  }

  .project-media {
    width: 100%;
    margin-bottom: 2rem;
  }

  .project-media img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 8px;
  }

  .project-links {
    margin: 2rem 0;
  }

  .project-links a {
    display: inline-block;
    padding: 0.8rem 1.5rem;
    background: var(--color-accent, #b8d47a);
    color: var(--color-background, #121820);
    border-radius: 8px;
    text-decoration: none;
    font-weight: 600;
  }

  .project-links a:hover {
    filter: brightness(1.1);
  }

  .project-content {
    margin-top: 3rem;
    line-height: 1.8;
    color: var(--color-text-muted, #b5c0cc);
    font-size: 1rem;
    overflow-wrap: break-word;
  }

  .project-content :global(h1),
  .project-content :global(h2),
  .project-content :global(h3) {
    color: var(--color-text, #f4f6f8);
    margin-top: 2.5rem;
    margin-bottom: 1rem;
  }

  .project-content :global(p) {
    margin-bottom: 1.25rem;
  }

  .project-content :global(li) {
    margin-bottom: 0.5rem;
  }

  .project-content :global(a) {
    color: var(--color-accent, #b8d47a);
  }

  .project-content :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: 8px;
  }

  .project-content :global(pre) {
    max-width: 100%;
    overflow-x: auto;
    padding: 1rem;
    border-radius: 8px;
  }

  .extra-links {
    margin-top: 2rem;
  }

  .extra-links a {
    color: var(--color-accent, #b8d47a);
  }

  .related-posts {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border, #364252);
  }

  .related-posts h2 {
    font-size: 1.8rem;
    margin-bottom: 0.5rem;
    color: var(--color-text, white);
  }

  .related-intro {
    color: var(--color-text-muted, #b5c0cc);
    margin-bottom: 1.5rem;
  }

  .related-post-list {
    display: grid;
    gap: 1rem;
  }

  .related-post {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    flex-wrap: wrap;
    gap: 1rem;

    padding: 1.25rem;
    border-radius: 10px;

    background: var(--color-surface, #1d2631);
    color: var(--color-text, white);
    text-decoration: none;

    transition: background 0.2s;
  }

  .related-post:hover {
    background: var(--color-surface-light, #293442);
  }

  .related-post-info {
    flex: 1;
    min-width: 200px;
  }

  .post-category {
    color: var(--color-accent, #b8d47a);
    text-transform: capitalize;
    font-size: 0.8rem;
    font-weight: 600;
  }

  .related-post h3 {
    margin: 0.5rem 0;
    color: var(--color-text, white);
    font-size: 1.2rem;
  }

  .related-post p {
    margin: 0;
    color: var(--color-text-muted, #b5c0cc);
    font-size: 0.9rem;
    line-height: 1.6;
  }

  .related-post time {
    color: var(--color-text-muted, #b5c0cc);
    font-size: 0.85rem;
    white-space: nowrap;
  }

  .post-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .post-tags span {
    padding: 0.25rem 0.65rem;
    border-radius: 6px;
    background: var(--color-background, #121820);
    color: var(--color-text-muted, #b5c0cc);
    font-size: 0.75rem;
  }

  @media (max-width: 600px) {
    .project-page {
      padding: 2rem 1rem 4rem;
    }

    .related-post {
      flex-direction: column;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .related-post {
      transition: none;
    }
  }
</style>