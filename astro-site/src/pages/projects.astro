
---
import BaseLayout from "../layouts/BaseLayout.astro";
import ProjectCard from "../components/ProjectCard.astro";

const projects = [
  {
    title: "Ashborn",
    category: "Professional",
    description:
      "A 3D RPG developed in Unity, where I worked as lead programmer.",
    image: "/img/ashbornIMG.png"
  },
  {
    title: "Real Time Shadows Demo",
    category: "University",
    description:
      "Real-time hard and soft shadow simulation using C++ and OpenGL.",
    youtubeUrl: "https://youtu.be/WKsjZeUeNe4"
  },
  {
    title: "Incrementum",
    category: "University",
    description:
      "A psychological thriller created in Unity with a team of six developers and designers.",
    youtubeUrl: "https://youtu.be/MnPYQWexebo"
  },
  {
    title: "Zemiaball",
    category: "University",
    description:
      "A 3D platformer made in Unity using C#.",
    youtubeUrl: "https://youtu.be/SpCocheSk68"
  },
  {
    title: "3D Game Engine",
    category: "University",
    description:
      "A custom 3D engine built using OpenGL and a component-entity system.",
    youtubeUrl: "https://youtu.be/DOHc-LiPZdo"
  },
  {
    title: "Mandelbrot Fractal",
    category: "University",
    description:
      "Experiments with SDL and C++ to generate colourful fractal patterns.",
    youtubeUrl: "https://youtu.be/aSrxNcYajv0"
  },
  {
    title: "Blackjack",
    category: "University",
    description:
      "A single-player, console-based Blackjack game written in C++.",
    youtubeUrl: "https://youtu.be/a9eGyd9urGs"
  },
  {
    title: "Dirtball Wars",
    category: "University",
    description:
      "A 2D game made using C++ and SDL, inspired by Raft Wars.",
    youtubeUrl: "https://youtu.be/_uOkW79P-hc"
  },
  {
    title: "Ignacio",
    category: "University",
    description:
      "A platformer created using Construct as an introduction to game development.",
    youtubeUrl: "https://youtu.be/k97Nx0AmN8o"
  },
  {
    title: "The Tomb of Anubis",
    category: "University",
    description:
      "A multiplayer tabletop board game designed around strategic card-based gameplay.",
    youtubeUrl: "https://youtu.be/Ek9Dj50CA74"
  },
  {
    title: "Amazing Katamari Damacy Marketing Proposal",
    category: "University",
    description:
      "A simulated business marketing proposal, developed through a team project.",
    youtubeUrl: "https://youtu.be/_t-IoOjHXrA"
  }
];
---

<BaseLayout
  title="Projects"
  description="Games, software and creative projects."
  currentPage="projects"
>
  <section class="projects-page container">
    <h1>My Projects</h1>

    <p>
      A collection of games, software and creative
      projects I've worked on over the years.
    </p>

    <div class="project-grid">
      {projects.map((project) => (
        <ProjectCard {...project} />
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .projects-page {
    padding-top: 3rem;
    padding-bottom: 4rem;
  }

  .project-grid {
    display: grid;
    grid-template-columns:
      repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 1.5rem;
    margin-top: 2rem;
  }
</style>
