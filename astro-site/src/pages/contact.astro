---
import BaseLayout from "../layouts/BaseLayout.astro";

const email = "yashvishwanath@yahoo.com";

const links = [
  {
    title: "Email",
    description: "Send me a message",
    icon: "✉️",
    href: `mailto:${email}`,
    external: false
  },
  {
    title: "GitHub",
    description: "Explore my code and projects",
    icon: "💻",
    href: "https://github.com/phinion",
    external: true
  },
  {
    title: "LinkedIn",
    description: "Connect with me professionally",
    icon: "🔗",
    href: "https://www.linkedin.com/in/yash-vishwanath/",
    external: true
  },
  {
    title: "Download CV",
    description: "View my experience and technical skills",
    icon: "📄",
    href: "/files/Yash-Vishwanath-CV.pdf",
    external: false,
    download: true
  }
];
---

<BaseLayout
  title="Contact"
  description="Get in touch with Yash Vishwanath."
  currentPage="contact"
>
  <section class="contact-page container">

    <!-- Introduction -->
    <div class="contact-intro">
      <p class="eyebrow">GET IN TOUCH</p>

      <h1>Let's connect.</h1>

      <p>
        Interested in my work, collaborating on a
        project or just want to say hello?
      </p>

      <p>
        You can find me through any of the links below.
      </p>
    </div>

    <!-- Contact links -->
    <div class="contact-grid">
      {links.map((link) => (
        <a
          href={link.href}
          class="contact-card"
          target={link.external ? "_blank" : undefined}
          rel={link.external ? "noopener noreferrer" : undefined}
          download={link.download ? "" : undefined}
        >
          <div class="card-heading">
            <span class="card-icon" aria-hidden="true">
              {link.icon}
            </span>

            <h2>{link.title}</h2>
          </div>

          <p>{link.description}</p>

          <span class="card-arrow" aria-hidden="true">
            {link.download ? "↓" : "↗"}
          </span>
        </a>
      ))}
    </div>

    <!-- Additional message -->
    <div class="contact-footer">
      <h2>Let's make something cool.</h2>

      <p>
        I'm always interested in hearing about
        creative projects, games and technology.
      </p>

      <a href={`mailto:${email}`} class="email-button">
        Send an Email →
      </a>
    </div>

  </section>
</BaseLayout>

<style>
  .contact-page {
    padding: 4rem 0 6rem;
  }

  /* Introduction */

  .contact-intro {
    max-width: 700px;
    margin-bottom: 3rem;
  }

  .eyebrow {
    color: var(--color-accent);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .contact-intro h1 {
    font-size: clamp(3rem, 7vw, 5rem);
    margin: 1rem 0;
  }

  .contact-intro p {
    color: var(--color-text-muted);
    font-size: 1.1rem;
    line-height: 1.8;
  }

  /* Contact cards */

  .contact-grid {
    display: grid;
    grid-template-columns:
      repeat(auto-fill, minmax(min(100%, 280px), 1fr));
    gap: 1.5rem;
  }

  .contact-card {
    display: flex;
    flex-direction: column;
    min-height: 190px;

    padding: 1.5rem;
    border-radius: 12px;

    background: var(--color-surface);
    border: 1px solid var(--color-border);

    color: var(--color-text);
    text-decoration: none;

    transition:
      transform 0.2s ease,
      border-color 0.2s ease;
  }

  .contact-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-accent);
  }

  .card-heading {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .card-heading h2 {
    margin: 0;
    font-size: 1.3rem;
  }

  .card-icon {
    font-size: 1.75rem;
  }

  .contact-card p {
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .card-arrow {
    margin-top: auto;
    align-self: flex-end;

    color: var(--color-orange);
    font-size: 1.5rem;
  }

  /* Bottom message */

  .contact-footer {
    margin-top: 5rem;
    padding: 3rem 2rem;

    background: var(--color-surface);
    border-radius: 16px;

    text-align: center;
  }

  .contact-footer h2 {
    font-size: clamp(1.8rem, 4vw, 2.5rem);
    margin-top: 0;
  }

  .contact-footer p {
    color: var(--color-text-muted);
    margin-bottom: 2rem;
  }

  .email-button {
    display: inline-block;

    padding: 0.9rem 1.5rem;
    border-radius: 8px;

    background: var(--color-accent);
    color: var(--color-background);

    font-weight: 600;
    text-decoration: none;
  }

  .email-button:hover {
    background: var(--color-accent-hover);
  }

  /* Mobile */

  @media (max-width: 700px) {
    .contact-page {
      padding: 2.5rem 0 4rem;
    }

    .contact-footer {
      margin-top: 3rem;
      padding: 2rem 1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .contact-card {
      transition: none;
    }

    .contact-card:hover {
      transform: none;
    }
  }
</style>