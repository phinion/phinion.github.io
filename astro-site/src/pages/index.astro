
---
import BaseLayout from "../layouts/BaseLayout.astro";

const projects = [
  {
    title: "Real Time Shadows Demo",
    description:
      "Real time shadows simulation made using OpenGL in C++",
    image: "/img/RTS.JPG"
  },
  {
    title: "Incrementum",
    description:
      "Unity 3D thriller about human fears. Made in collaboration with 5 other game developers and designers.",
    image: "/img/Incrementum.JPG"
  },
  {
    title: "Tomb of Anubis",
    description:
      "Tabletop board game where players race to the centre of the board while battling each other using cards.",
    image: "/img/TombOfAnubis.JPG"
  }
];
---

<BaseLayout
  title="Home"
  description="Yash Vishwanath - Games Software Engineer"
  currentPage="home"
>
  <section id="showcase">
    <div class="container">
      <h1>Yash Vishwanath</h1>
      <p>Games Software Engineer</p>
    </div>
  </section>

  <section class="container">
    <h1>Welcome to my portfolio!</h1>
    <p>
      Check out who I am and projects I have worked on!!
    </p>
  </section>

  <section id="boxes">
    <div class="container">
      {projects.map((project) => (
        <div class="box">
          <img
            src={project.image}
            alt={project.title}
          />
          <h3>{project.title}</h3>
          <p>{project.description}</p>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
